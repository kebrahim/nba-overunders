# Supabase project settings — Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (group MMS thread — draft-turn and pick notifications). Optional:
# without these, /admin's "Create SMS group text" just stays unconfigured
# and no texts are sent. TWILIO_PHONE_NUMBER is the number you buy in the
# Twilio console (E.164, e.g. +18885551234); it becomes the sender/"from"
# address all participants see in their group thread. It must be added to
# the Messaging Service below (Console > Messaging > Services > your
# service > Sender Pool), and that same Messaging Service needs an
# approved A2P 10DLC campaign for the number to actually be allowed to
# send. TWILIO_MESSAGING_SERVICE_SID starts with "MG" — required for
# Conversations to add phone-number participants at all (a Conversation
# with no Messaging Service attached rejects them).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Shared secret checked on inbound Twilio webhook requests (a STOP/START
# reply to the group thread) — see src/app/api/twilio/inbound/route.ts.
# Optional: without it, opt-out replies aren't tracked in the app (Twilio
# still blocks delivery at the carrier level either way — this only
# affects whether /admin shows who's opted out). Make up any random
# string, then configure the same URL + secret as this route's Post-Event
# webhook in the Twilio Console under Conversations > Services > (your
# service) > Webhooks, for the onMessageAdded event:
#   https://<your-app>/api/twilio/inbound?secret=<this value>
TWILIO_INBOUND_WEBHOOK_SECRET=

# Anthropic (Claude writes the weekly recap + preview text). Optional:
# without it, the weekly text falls back to a plain league-wide
# scoring-pace line.
ANTHROPIC_API_KEY=

# Authorizes Vercel Cron's daily call to /api/sync/games (Vercel sends
# "Authorization: Bearer $CRON_SECRET" automatically once this is set)
CRON_SECRET=

# Branding. Optional: the app is called "Hardwood" unless this is set —
# changing it here (or on Vercel) renames it everywhere, texts included.
NEXT_PUBLIC_APP_NAME=

# Public URL, used for links inside texts (e.g. https://hardwood.example.com).
# Optional: falls back to Vercel's production URL.
NEXT_PUBLIC_SITE_URL=
